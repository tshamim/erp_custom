# Paste into Coolify → your resource → Environment Variables → Developer view, then replace every
# <...> value. Generate the secrets with the commands in COOLIFY.md; never reuse development values.

# Public addresses. The API domain must start with "api." (see COOLIFY.md, "Domains").
# Add ",https://*.erp.example.com" when companies use their own subdomain (COOLIFY.md).
WEB_ORIGIN=https://erp.example.com
APP_URL=https://erp.example.com
# Baked into the browser bundle at build time: tick "Available at Buildtime" for this one.
NEXT_PUBLIC_API_URL=https://api.example.com
# The web hostname, no https:// — companies become its subdomains. Also "Available at Buildtime".
NEXT_PUBLIC_APP_DOMAIN=erp.example.com

# Secrets
TENANT_SECRET_KEY=<openssl rand -hex 32>
JWT_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<openssl rand -hex 32>
PG_ADMIN_PASSWORD=<openssl rand -hex 24>
MINIO_SECRET_KEY=<openssl rand -hex 24>

# Platform owner, created on the first deploy
PLATFORM_ADMIN_EMAIL=<owner@yourcompany.com>
PLATFORM_ADMIN_PASSWORD=<a strong password you choose>

# Email (Mailtrap). Leave the token empty and mail is only logged, never sent.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
MAIL_FROM=no-reply@yourcompany.com
MAIL_FROM_NAME=Eclectic ERP
MAIL_REPLY_TO=
BRAND_NAME=Eclectic ERP

# Optional tuning (defaults shown)
# PG_SHARED_BUFFERS=512MB          # ~25% of server RAM
# PG_EFFECTIVE_CACHE_SIZE=1536MB   # ~50% of server RAM
# TENANT_POOL_MAX=50
# MAX_UPLOAD_MB=20
